          "text": "кот",
          "english": "cat"
        },
        {
          "text": "там",
          "english": "there"
        },
        {
          "text": "так",
          "english": "so, like this"
        },
        {
          "text": "+атом",
          "english": "atom"
        }
      ]
    },
